# =====================================================================
# Le fichier .env du SERVEUR : copie-le en /var/www/pokesio/.env, puis remplis les ⚠.
# Ne le mets JAMAIS sur GitHub (il contient tes mots de passe) : .gitignore l'exclut déjà.
# =====================================================================
APP_NAME="PokéSIO"
APP_ENV=production
# ⚠ Généré par : php artisan key:generate
APP_KEY=
# Jamais true en ligne : les erreurs montreraient tes mots de passe
APP_DEBUG=false
# ⚠ Ton domaine
APP_URL=https://pokesio.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
# Un fichier de log par jour (gardés 14 jours), seulement les avertissements et erreurs
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pokesio
DB_USERNAME=pokesio
# ⚠ Le mot de passe MySQL choisi à l'étape 5
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Le cookie de connexion ne circule qu'en HTTPS
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# Le jeu n'utilise pas de file d'attente : tout est fait tout de suite
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ---- Multijoueur (Reverb) ----
BROADCAST_CONNECTION=reverb
# ⚠ 3 valeurs au hasard : tape  openssl rand -hex 16  trois fois sur le serveur
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Ce que voient les navigateurs (passe par Nginx, en HTTPS) ; ⚠ ton domaine
REVERB_HOST=pokesio.fr
REVERB_PORT=443
REVERB_SCHEME=https
# Le serveur Reverb lui-même, en local (Nginx lui transmet les connexions)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ---- E-mails (mot de passe oublié) ----
# Sans configuration : MAIL_MAILER=log (les e-mails sont écrits dans storage/logs, rien n'est envoyé).
# Avec un service gratuit (ex. Brevo) : remplis ces lignes avec les identifiants SMTP qu'il te donne.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pokesio.fr"
MAIL_FROM_NAME="${APP_NAME}"
